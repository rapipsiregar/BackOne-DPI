FROM oven/bun:1-alpine

WORKDIR /app

COPY proxy/package*.json ./
RUN bun install --production

COPY proxy/ .

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD bun -e "require('http').get('http://localhost:4000/health', r => r.statusCode === 200 ? process.exit(0) : process.exit(1)).on('error', () => process.exit(1))"

CMD ["bun", "run", "index.js"]
