FROM oven/bun:1-alpine

WORKDIR /app

COPY backend/package*.json ./
RUN bun install --production

COPY backend/ .

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD bun -e "require('http').get('http://localhost:3001/api/health', r => r.statusCode === 200 ? process.exit(0) : process.exit(1)).on('error', () => process.exit(1))"

CMD ["bun", "run", "server.js"]
