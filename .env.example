# ─── BACKONE (PT. DATA BISNIS SOLUSI) API CONFIGURATION ───────────────────────
# Copy this file to .env.local and populate the values.
# DO NOT commit .env.local containing real credentials to GitHub.

# Primary BackOne Branding Variables
BACKONE_API_KEY=
BACKONE_JWT_TOKEN=
BACKONE_SITE_UUID=
BACKONE_BASE_URL=

# Legacy Netify Fallback Variables (Will be used if BACKONE_ variables are empty)
NETIFY_API_KEY=
NETIFY_JWT_TOKEN=
NETIFY_SITE_UUID=
NETIFY_BASE_URL=

# Express Backend Service URL (Frontend connects to this proxy)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
